# ============================================================
# Banco cacaopay — configuración
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio (contiene credenciales).
# ============================================================

# Neon PostgreSQL (usa la connection string del "pooler").
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Alternativa si prefieres variables individuales (sin DATABASE_URL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=
# DB_SSLMODE=require

# Firma de tokens JWT (usa una cadena larga y aleatoria).
JWT_SECRET=change-me-to-a-long-random-string

# Origen permitido para CORS (dominio de tu frontend).
CLIENT_ORIGIN=http://localhost:8000

# Moneda fiat base y tasa de conversión a cacao.
FIAT_CURRENCY=PEN
CACAO_PER_FIAT=2

# Muestra errores en pantalla (false en producción).
APP_DEBUG=true
