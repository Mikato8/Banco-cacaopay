# ============================================================
# Banco cacaopay — configuración
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio (contiene credenciales).
# ============================================================

# MySQL (Hostinger: crea la base de datos y el usuario en hPanel).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cacaopay
DB_USER=cacaopay_user
DB_PASSWORD=

# Alternativa con una URL completa:
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/cacaopay

# Firma de tokens JWT (usa una cadena larga y aleatoria).
JWT_SECRET=change-me-to-a-long-random-string

# Origen permitido para CORS (dominio de tu frontend).
CLIENT_ORIGIN=https://tudominio.com

# Moneda fiat base y tasa de conversión a cacao (1 cacao = 1 MXN).
FIAT_CURRENCY=MXN
CACAO_PER_FIAT=1

# ============================================================
# Módulo fiscal (SAT) — identidad fiscal del emisor (opcional)
# CFDI interno simulado: no se timbra ni se valida ante el SAT.
# Si se dejan vacías se usan los defaults; también se pueden
# guardar desde la UI (pestaña "Fiscal · SAT", rol ADMIN) o con
# POST /api/fiscal/settings.
# ============================================================

# RFC del emisor (vacío = módulo sin configurar → alerta CONFIGURACION_FISCAL).
FISCAL_RFC=
# Razón social del emisor.
FISCAL_RAZON_SOCIAL=
# Clave de régimen fiscal SAT (601, 606, 612, 626…).
FISCAL_REGIMEN=612
# Código postal del lugar de expedición.
FISCAL_CP=
# Serie por defecto de los CFDI.
FISCAL_SERIE=A
# Tasa de IVA trasladado (0.16 = 16 %).
FISCAL_IVA_RATE=0.16
# Moneda de los CFDI (MXN por defecto).
FISCAL_MONEDA=MXN

# Tasas anuales de inversión y préstamos (0.05 = 5%, 0.12 = 12%).
INVEST_ANNUAL_RATE=0.05
LOAN_ANNUAL_RATE=0.12
LOAN_TERM_DAYS=30

# Muestra errores en pantalla (false en producción).
APP_DEBUG=true

# Permite ejecutar /install.php una sola vez (después ponlo en false y borra install.php).
APP_INSTALL=true
